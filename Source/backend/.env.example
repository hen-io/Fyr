HA_URL=http://your-home-assistant:8123
HA_TOKEN=replace-with-a-home-assistant-long-lived-access-token
HA_WEATHER_ENTITY=weather.home
HA_HOME_MODE_ENTITY=
HA_INDOOR_TEMP_ENTITY=
# Empty by default - the calendar feature is a no-op until you set this to
# whichever calendar.* entity Home Assistant exposes. Comma-separate more
# than one to pull events from multiple calendars.
HA_CALENDAR_ENTITY=
WEATHER_CACHE_TTL=300
PORT=8584

# MQTT is not active yet - these are read but unused until MQTT_ENABLED=true.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Signs session cookies - required, the app refuses to start without it.
# Generate one per deployment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Keep it stable once set - changing it logs everyone out.
SESSION_SECRET=replace-with-a-generated-random-hex-secret

# Two separate volumes (see docker-compose.yml):
#   CONFIG_DIR - apps.config, ui.conf, icons/. What you actually hand-edit.
#   DATA_DIR   - users.json, prefs.json, sessions. Internal state - the app
#                manages this itself, never meant to be hand-edited.
CONFIG_DIR=/config
DATA_DIR=/data

# Hostname patterns /api/status is allowed to check (comma-separated glob
# patterns). Prevents that endpoint from being an open proxy for arbitrary
# URLs. Empty by default (nothing allowed) until you set this - fill in
# your own app hostnames, e.g. *.example.com,*.lan
STATUS_ALLOWED_HOSTS=
